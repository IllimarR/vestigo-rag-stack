[importlinter]
root_packages =
    contracts
    control_plane
    services
include_external_packages = True

[importlinter:contract:contracts-are-sink]
name = contracts depends on nothing project-owned
type = forbidden
source_modules =
    contracts
forbidden_modules =
    control_plane
    services

[importlinter:contract:control-plane-is-sink]
name = control_plane infra package depends on nothing project-owned
type = forbidden
source_modules =
    control_plane
forbidden_modules =
    services

[importlinter:contract:no-cross-service-imports]
name = Service modules never import each other
type = independence
modules =
    services.ingest
    services.retrieval
    services.llm
    services.vector_store
    services.audit
    services.api_gateway
    services.admin

[importlinter:contract:vector-store-is-sole-db-access]
name = Only services.vector_store may touch vector DB drivers
type = forbidden
source_modules =
    services.ingest
    services.retrieval
    services.llm
    services.audit
    services.api_gateway
    services.admin
forbidden_modules =
    chromadb
    pgvector

[importlinter:contract:control-plane-db-is-admin-and-audit-only]
name = Only services.admin and services.audit may touch the control-plane DB
type = forbidden
source_modules =
    services.ingest
    services.retrieval
    services.llm
    services.api_gateway
    services.vector_store
forbidden_modules =
    sqlalchemy
    control_plane

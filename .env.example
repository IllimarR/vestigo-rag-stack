# vestigo-rag-stack — infrastructure-level configuration
#
# Application-level settings (models, chunking, prompts, default collection)
# are NOT here — they live in ConfigProvider per docs/contracts.md §9.
# Everything below is a deployment-time decision read only by the composition
# root (main.py) and infrastructure adapters.

# --- Service ports --------------------------------------------------------
# Reserved for future services (do not reuse):
#   3000  admin-ui (Node.js + React, Phase 4)
#   8080  embedding-model (Docker-internal embedding service)
API_GATEWAY_PORT=8000
ADMIN_API_PORT=8001
INGEST_API_PORT=8002

# --- Infrastructure bindings ---------------------------------------------
# Backends are selected at deployment time, not via ConfigProvider.

VECTOR_STORE_BACKEND=in_memory             # in_memory | chromadb (pgvector later)
AUDIT_BACKEND=placeholder                  # future: file | database
CONFIG_BACKEND=placeholder                 # future: file | database
DOCUMENT_CONVERTER=placeholder             # future: pandoc | markitdown
SOURCE_CONNECTORS=placeholder              # future: filesystem,api_push,...

# --- File paths for file-based stubs (Phase 1/2) --------------------------
CONFIG_FILE_PATH=./config/config.yaml
AUDIT_LOG_FILE=./data/audit.log
# ChromaDB runs as a separate container; defaults target the Docker
# Compose layout (service name = chromadb, internal port = 8000 — no
# collision with the gateway because they are different hosts inside
# the Docker network). For local dev without Docker, override
# CHROMADB_HOST=localhost and remap CHROMADB_PORT to avoid :8000.
CHROMADB_HOST=chromadb                     # only used when VECTOR_STORE_BACKEND=chromadb
CHROMADB_PORT=8000
CHROMADB_SSL=false

# --- Database (Phase 4) ---------------------------------------------------
DATABASE_URL=

# --- Admin bootstrap (Phase 4) --------------------------------------------
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=change-me

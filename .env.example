# vestigo-rag-stack — infrastructure-level configuration
#
# Application-level settings (models, chunking, prompts, default collection)
# are NOT here — they live in ConfigProvider per docs/contracts.md §9.
# Everything below is a deployment-time decision read only by the composition
# root (main.py) and infrastructure adapters.

# --- Service ports --------------------------------------------------------
# Reserved for future services (do not reuse):
#   3000  admin-ui (Node.js + React, Phase 4)
#   8080  embedding-model (Docker-internal embedding service)
API_GATEWAY_PORT=8000
ADMIN_API_PORT=8001
INGEST_API_PORT=8002

# --- Infrastructure bindings ---------------------------------------------
# Backends are selected at deployment time, not via ConfigProvider.

VECTOR_STORE_BACKEND=in_memory             # in_memory | chromadb (pgvector later)
AUDIT_BACKEND=file                         # file | sqlite
CONFIG_BACKEND=file                        # file | sqlite
API_KEY_BACKEND=env                        # env | sqlite
DOCUMENT_CONVERTER=markitdown              # markitdown (pandoc, docling later)
SOURCE_CONNECTORS=filesystem               # comma list: filesystem (api_push later)

# --- File paths for file-based adapters ----------------------------------
CONFIG_FILE_PATH=./config/config.yaml
AUDIT_LOG_FILE=./data/audit.log
INGEST_FILESYSTEM_ROOT=./data/incoming     # only used when SOURCE_CONNECTORS=filesystem
# ChromaDB runs as a separate container reachable on the Docker
# internal network (service name = chromadb, port = 8500). The port
# is deliberately off the ChromaDB default (8000) so a host-mode dev
# setup can run both the gateway and ChromaDB without colliding.
# For local dev without Docker, override CHROMADB_HOST=localhost.
CHROMADB_HOST=chromadb                     # only used when VECTOR_STORE_BACKEND=chromadb
CHROMADB_PORT=8500
CHROMADB_SSL=false

# --- Control-plane DB (Phase 4) -------------------------------------------
# Single SQLite file shared by the admin and audit services when their
# *_BACKEND envs are set to "sqlite". Schema is bootstrapped on first
# boot via Base.metadata.create_all(); Alembic is deferred until a real
# migration is needed.
CONTROL_PLANE_DB_PATH=./data/control_plane.db

# --- API Gateway authentication ------------------------------------------
# Comma-separated allow-list of Bearer tokens accepted by POST /v1/responses.
# Each entry is either a bare key (audit id derived from key prefix) or
# `name:key` (audit id = name). With API_KEY_BACKEND=env this is the live
# allow-list. With API_KEY_BACKEND=sqlite these entries are seeded into
# the DB on first run, then keys are managed via the Admin API.
# Empty = dev mode, every request audited under `api_key_id=anonymous`.
API_KEYS=

# --- Admin API authentication --------------------------------------------
# Single shared secret for the Admin API. When unset, the admin runs
# unauthenticated (dev mode). Phase 6 will introduce per-user / role-aware
# admin auth — the route shape will stay the same.
ADMIN_API_KEY=
